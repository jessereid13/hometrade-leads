# Postgres (Neon, Supabase, Railway, RDS all work)
DATABASE_URL="postgresql://user:pass@host:5432/hometrade?sslmode=require"

# 32+ random chars. Signs the session cookie.  openssl rand -base64 32
AUTH_SECRET="change-me"

# Public URL of the deployed app (used for Stripe redirects and emails)
APP_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional: shared secret for the public lead-intake API (Zapier, external forms)
LEAD_API_KEY="change-me-too"

# Optional: Resend for new-lead email alerts. Leave blank to log to console.
RESEND_API_KEY=""
EMAIL_FROM="Hometrade Leads <leads@yourdomain.com>"

# First admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"
